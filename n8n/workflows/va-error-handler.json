        "options": {
          "queryReplacement": "={{ [ JSON.stringify({ workflow: ($json.workflow || {}).name, node: ($json.execution || {}).lastNodeExecuted, message: (($json.execution || {}).error || {}).message, execution: ($json.execution || {}).id }) ] }}"
        }
      },
