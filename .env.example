# Copy to .env for non-Colab runs. In Colab, use the Secrets panel instead
# (ops/secrets.py generates any missing value and stores it on Drive).
# NEVER commit a filled-in copy.

# --- voice engine ---
VOICE_ENGINE_WS_TOKEN=          # >= 24 chars; browser/WebSocket access
VOICE_ENGINE_GATEWAY_TOKEN=     # >= 24 chars; Redmi 9C HFP gateway box (also in the box's ~/.config/voice-gateway/env)
VOICE_ENGINE_CALLS_TOKEN=       # >= 24 chars; n8n -> POST /calls
VOICE_AGENT_ROOT=               # persistent root (models/, logs/, results/); Colab: /content/drive/MyDrive/voice-agent
VOICE_ENGINE_CONFIG=            # optional runtime YAML; defaults to config/voice_engine.yaml

# --- LLM server (llama.cpp) ---
LLM_API_KEY=
LLAMA_CPP_TAG=b11700

# --- PostgreSQL ---
PG_SUPERUSER_PASSWORD=
PG_OWNER_PASSWORD=              # role va_owner (migrations)
PG_APP_PASSWORD=                # role va_app (n8n business data access)
PG_N8N_PASSWORD=                # role n8n_sys (n8n internal database)

# --- n8n ---
N8N_ENCRYPTION_KEY=             # keep safe: losing it makes stored n8n credentials unreadable
N8N_WEBHOOK_HMAC_SECRET=        # voice engine -> n8n request signatures
N8N_VERSION=2.45.3
NODE_VERSION=v24.22.1

# --- optional ---
HF_TOKEN=
AZURE_SPEECH_KEY=               # paid TTS reference only
CLOUDFLARE_TUNNEL_TOKEN=        # named tunnel for a stable hostname
VOICE_ENGINE_PUBLIC_URL=        # that hostname, e.g. https://voice-dev.example.com
CLOUDFLARED_VERSION=2026.10.1
GIT_REPO_URL=
GIT_REPO_TOKEN=
